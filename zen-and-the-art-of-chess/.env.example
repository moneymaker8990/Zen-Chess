# ============================================
# Zen Chess - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# All variables prefixed with VITE_ are exposed to the client.
# Do NOT commit .env.local or .env files with real values.

# ============================================
# SUPABASE (Auth & Cloud Sync)
# ============================================
# Required for: user accounts, cloud saves, multiplayer
# The app works offline without these (local-only mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ============================================
# AI COACHING (Anthropic Claude)
# ============================================
# Required for: AI coach, position analysis, puzzle explanations
# Features gracefully degrade without this key
#
# SERVER-SIDE ONLY — used by the Vercel Edge Function and Vite dev proxy.
# This key is NEVER bundled into client-side JavaScript.
ANTHROPIC_API_KEY=
# Legacy alias (read by the Vite dev proxy as a fallback):
# VITE_ANTHROPIC_API_KEY=

# ============================================
# PAYMENTS - Stripe (Web)
# ============================================
# Required for: premium subscriptions on web
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PRICE_MONTHLY=
VITE_STRIPE_PRICE_YEARLY=
VITE_STRIPE_PRICE_LIFETIME=
VITE_API_URL=

# ============================================
# PAYMENTS - RevenueCat (Mobile)
# ============================================
# Required for: in-app purchases on iOS/Android
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=

# ============================================
# ERROR TRACKING (Sentry)
# ============================================
# Required for: production error monitoring
# Only active in production builds
VITE_SENTRY_DSN=

# ============================================
# ANALYTICS (PostHog)
# ============================================
# Required for: product analytics and user behavior tracking
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# ============================================
# APP CONFIG
# ============================================
# Public URL of the deployed app (used for invite links)
VITE_APP_URL=https://zenchess.app

# Enable verbose debug logging (set to "true" to enable)
VITE_DEBUG=false

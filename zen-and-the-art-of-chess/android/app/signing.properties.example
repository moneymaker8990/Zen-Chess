# ============================================
# ANDROID SIGNING CONFIGURATION
# ============================================
# Copy this file to signing.properties and fill in your values
# DO NOT commit the actual signing.properties file to git!

# Path to your keystore file (relative to android/app/ directory)
STORE_FILE=release-key.keystore

# Keystore password (set via environment variable in CI/CD)
STORE_PASSWORD=your_keystore_password

# Key alias in the keystore
KEY_ALIAS=zen-chess

# Key password (often same as store password)
KEY_PASSWORD=your_key_password

# ============================================
# GENERATING A NEW KEYSTORE
# ============================================
# Run this command to generate a new keystore:
#
# keytool -genkeypair -v -storetype PKCS12 -keystore release-key.keystore \
#   -alias zen-chess -keyalg RSA -keysize 2048 -validity 10000 \
#   -dname "CN=Zen Chess, OU=Mobile, O=Your Company, L=City, ST=State, C=US"
#
# Store the keystore file securely and never commit it to git!
# Keep the passwords in a secure password manager.

# ============================================
# FOR CI/CD (GitHub Actions)
# ============================================
# Store the keystore as a base64-encoded secret:
#   base64 -i release-key.keystore | pbcopy
#
# Then add these secrets to your GitHub repository:
#   - ANDROID_KEYSTORE_BASE64: The base64-encoded keystore
#   - ANDROID_KEYSTORE_PASSWORD: The keystore password
#   - ANDROID_KEY_ALIAS: The key alias (zen-chess)
#   - ANDROID_KEY_PASSWORD: The key password
